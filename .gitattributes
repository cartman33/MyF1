# Git 속성 설정 파일
# 파일별 Git 동작을 제어합니다.

# 모든 텍스트 파일을 자동으로 감지하고 줄 끝을 정규화
* text=auto

# Java 소스 파일은 항상 LF로 정규화
*.java text eol=lf

# JavaScript/TypeScript 파일은 항상 LF로 정규화
*.{js,jsx,ts,tsx} text eol=lf

# JSON 파일은 항상 LF로 정규화
*.json text eol=lf

# YAML 파일은 항상 LF로 정규화
*.{yml,yaml} text eol=lf

# Markdown 파일은 항상 LF로 정규화
*.md text eol=lf

# 바이너리 파일로 처리
*.{png,jpg,jpeg,gif,ico,svg,woff,woff2,ttf,eot} binary

# Gradle wrapper는 실행 가능하게 유지
gradlew text eol=lf
gradlew.bat text eol=crlf

