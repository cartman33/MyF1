# ============================================
# 환경 변수 및 보안 파일
# ============================================
# .env 파일은 절대 Git에 커밋하지 마세요!
backend/.env
.env.local
.env.*.local

# ============================================
# Node.js
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ============================================
# 빌드 출력물
# ============================================
# Java
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*

# React
build/
dist/
*.tsbuildinfo

# ============================================
# IDE 및 에디터
# ============================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# VS Code
.vscode/
*.code-workspace

# Vim
*.swp
*.swo
*~

# ============================================
# 운영체제 파일
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================
# 로그 파일
# ============================================
*.log
logs/
*.log.*

# ============================================
# Gradle
# ============================================
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ============================================
# 기타
# ============================================
# 임시 파일
*.tmp
*.temp
*.bak
*.cache

# 패키지 관리자
package-lock.json
yarn.lock
pnpm-lock.yaml

# 테스트 커버리지
coverage/
.nyc_output/
*.lcov

# 환경 변수 예제는 커밋 (실제 값은 제외)
!.env.example
